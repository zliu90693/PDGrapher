// Computational graph for the feedforward sweep
digraph Sequential {
	graph [label=<<B>Sequential</B><br align='left'/>5 tensors total (1.1 KB)<br align='left'/>325 params total (1.7 KB)<br align='left'/>> labeljust=left labelloc=t ordering=out rankdir=BT]
	node [ordering=out]
	input_1 [label=<<b>input_1</b><br/>2x10 (208 B)<br/>@input.input> color=black fillcolor="#98FB98" fontcolor=black ordering=out shape=oval style="filled,solid"]
	input_1 -> linear_1_1 [arrowsize=.7 color=black fontcolor=black labelfontsize=8 style=solid]
	linear_1_1 [label=<<b>linear_1_1</b><br/>2x20 (288 B)<br/>params: 20x10, x20<br/>@0> color=black fillcolor="#E6E6E6" fontcolor=black ordering=out shape=box style="filled,solid"]
	linear_1_1 -> relu_1_2 [arrowsize=.7 color=black fontcolor=black labelfontsize=8 style=solid]
	relu_1_2 [label=<<b>relu_1_2</b><br/>2x20 (288 B)<br/>@1> color=black fillcolor=white fontcolor=black ordering=out shape=box style="filled,solid"]
	relu_1_2 -> linear_2_3 [arrowsize=.7 color=black fontcolor=black labelfontsize=8 style=solid]
	linear_2_3 [label=<<b>linear_2_3</b><br/>2x5 (168 B)<br/>params: 5x20, x5<br/>@2> color=black fillcolor="#E6E6E6" fontcolor=black ordering=out shape=box style="filled,solid"]
	linear_2_3 -> output_1 [arrowsize=.7 color=black fontcolor=black labelfontsize=8 style=solid]
	output_1 [label=<<b>output_1</b><br/>2x5 (168 B)<br/>@output> color=black fillcolor="#ff9999" fontcolor=black ordering=out shape=oval style="filled,solid"]
	{
		rank=sink
		output_1
	}
	subgraph cluster_0_pass1 {
		fillcolor=white label=<<B>@0</B><br align='left'/>(Linear)<br align='left'/>> labelloc=b penwidth=5.0 style="filled,dashed"
	}
	subgraph cluster_1_pass1 {
		fillcolor=white label=<<B>@1</B><br align='left'/>(ReLU)<br align='left'/>> labelloc=b penwidth=5.0 style="filled,dashed"
	}
	subgraph cluster_2_pass1 {
		fillcolor=white label=<<B>@2</B><br align='left'/>(Linear)<br align='left'/>> labelloc=b penwidth=5.0 style="filled,dashed"
	}
}
